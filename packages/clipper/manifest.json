{
  "manifest_version": 3,
  "name": "ApplyOS Clipper",
  "version": "0.1.0",
  "description": "Send the job posting you are looking at to your ApplyOS pipeline and start tailoring.",
  "action": {
    "default_title": "Import to ApplyOS",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
